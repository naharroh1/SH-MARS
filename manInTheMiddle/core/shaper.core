CAPI=2:

name : ::shaper:1
description : shaper 


targets:
  default:
    filesets:
      - rtl

  synt_sv_basys3:
    default_tool: vivado
    filesets:
      - rtl
      - basys3
    parameters:
      - WB_DATA=32
      - UART_SERVO_ADDR=400
      - UART_CAPTURER_ADDR=800
      - IMPOSTOR_ADDR=600
      - SHAPER_ADDR=200
      - FILE_MEM=/home/germancq/estancia_huelva/dynamixel_SV_wishbone/manInTheMiddle/memory.mem
    toplevel: shaper
    tools:
      vivado:
        part: xc7a35tcpg236-1

  sim:
    flow : sim
    flow_options:
      tool : icarus 
      iverilog_options : [-g2012]
      cocotb_module : shaper_test
      timescale : 1ns/1ns
      vcs_options : [-timescale=1ns/1ns] 
    filesets : [rtl, cocotb]
    toplevel : shaper 
    parameters :
      - WB_DATA=32
      - UART_SERVO_ADDR=400
      - UART_CAPTURER_ADDR=800
      - IMPOSTOR_ADDR=600
      - SHAPER_ADDR=200
      - FILE_MEM=/home/germancq/estancia_huelva/dynamixel_SV_wishbone/manInTheMiddle/memory.mem

  synt_sv_basys3_docker:
    default_tool: vivado
    filesets:
      - rtl_docker
      - basys3_docker
    parameters:
      - WB_DATA=32
      - UART_SERVO_ADDR=400
      - UART_CAPTURER_ADDR=800
      - IMPOSTOR_ADDR=600
      - SHAPER_ADDR=200
      - FILE_MEM=/work/manInTheMiddle/memory.mem
    toplevel: shaper
    tools:
      vivado:
        part: xc7a35tcpg236-1

  sim_docker:
    flow : sim
    flow_options:
      tool : icarus 
      iverilog_options : [-g2012]
      cocotb_module : shaper_test
      timescale : 1ns/1ns
      vcs_options : [-timescale=1ns/1ns] 
    filesets : [rtl_docker, cocotb_docker]
    toplevel : shaper 
    parameters :
      - WB_DATA=32
      - UART_SERVO_ADDR=400
      - UART_CAPTURER_ADDR=800
      - IMPOSTOR_ADDR=600
      - SHAPER_ADDR=200
      - FILE_MEM=/work/manInTheMiddle/memory.mem

parameters :
  WB_DATA :
    datatype : int
    paramtype : generic
  UART_CAPTURER_ADDR :
    datatype : int
    paramtype : generic
  UART_SERVO_ADDR :
    datatype : int
    paramtype : generic
  IMPOSTOR_ADDR :
    datatype : int
    paramtype : generic
  SHAPER_ADDR :
    datatype : int
    paramtype : generic
  FILE_MEM :
    datatype : file 
    paramtype : vlogparam 

filesets:

  rtl:
    file_type: verilogSource
    files:
      - /home/germancq/estancia_huelva/dynamixel_SV_wishbone/manInTheMiddle/hdl/shaper.sv
    depend:
      - stack
      - counter
      - register

  cocotb:
    files:
      - /home/germancq/estancia_huelva/dynamixel_SV_wishbone/manInTheMiddle/tb/shaper_test.py : {file_type : user, copyto : .}
    depend:
      - vlog_tb_utils

  basys3:
    file_type: xdc
    files:
      - /home/germancq/estancia_huelva/dynamixel_SV_wishbone/manInTheMiddle/constraints/basys3_shaper.xdc

  rtl_docker:
    file_type: verilogSource
    files:
      - /work/manInTheMiddle/hdl/shaper.sv
    depend:
      - stack
      - counter
      - register

  cocotb_docker:
    files:
      - /work/manInTheMiddle/tb/shaper_test.py : {file_type : user, copyto : .}
    depend:
      - vlog_tb_utils

  basys3_docker:
    file_type: xdc
    files:
      - /work/manInTheMiddle/constraints/basys3_shaper.xdc



