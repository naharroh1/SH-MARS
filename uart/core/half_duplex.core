CAPI=2:

name : ::half_duplex:1
description : half_duplex 


targets:
  default:
    filesets:
      - rtl

  synt_sv_basys3:
    default_tool: vivado
    filesets:
      - rtl
      - basys3
    toplevel: half_duplex
    tools:
      vivado:
        part: xc7a35tcpg236-1

  sim:
    flow : sim
    flow_options:
      tool : icarus 
      iverilog_options : [-g2012]
      cocotb_module : half_duplex_test
      timescale : 1ns/1ns
      vcs_options : [-timescale=1ns/1ns] 
    filesets : [rtl, cocotb]
    toplevel : half_duplex 

  synt_sv_basys3_docker:
    default_tool: vivado
    filesets:
      - rtl_docker
      - basys3_docker
    toplevel: half_duplex
    tools:
      vivado:
        part: xc7a35tcpg236-1

  sim_docker:
    flow : sim
    flow_options:
      tool : icarus 
      iverilog_options : [-g2012]
      cocotb_module : half_duplex_test
      timescale : 1ns/1ns
      vcs_options : [-timescale=1ns/1ns] 
    filesets : [rtl_docker, cocotb_docker]
    toplevel : half_duplex 

filesets:

  rtl:
    file_type: verilogSource
    files:
      - /home/germancq/estancia_huelva/dynamixel_SV_wishbone/uart/hdl/half_duplex.sv

  cocotb:
    files:
      - /home/germancq/estancia_huelva/dynamixel_SV_wishbone/uart/tb/half_duplex_test.py : {file_type : user, copyto : .}
    depend:
      - vlog_tb_utils

  basys3:
    file_type: xdc
    files:
      - /home/germancq/estancia_huelva/dynamixel_SV_wishbone/uart/constraints/basys3_half_duplex.xdc

  rtl_docker:
    file_type: verilogSource
    files:
      - /work/uart/hdl/half_duplex.sv

  cocotb_docker:
    files:
      - /work/uart/tb/half_duplex_test.py : {file_type : user, copyto : .}
    depend:
      - vlog_tb_utils

  basys3_docker:
    file_type: xdc
    files:
      - /work/uart/constraints/basys3_half_duplex.xdc

