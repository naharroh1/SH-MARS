CAPI=2:

name : ::uart:1
description : uart 


targets:
  default:
    filesets:
      - rtl

  synt_sv_basys3:
    default_tool: vivado
    filesets:
      - rtl
      - basys3
    parameters:
      - BAUDIOS=1000000
      - F_MHZ=100
    toplevel: uart
    tools:
      vivado:
        part: xc7a35tcpg236-1

  sim:
    flow : sim
    flow_options:
      tool : icarus 
      iverilog_options : [-g2012]
      cocotb_module : uart_test
      timescale : 1ns/1ns
      vcs_options : [-timescale=1ns/1ns] 
    filesets : [rtl, cocotb]
    toplevel : uart 
    parameters :
      - BAUDIOS=1000000
      - F_MHZ=100

  synt_sv_basys3_docker:
    default_tool: vivado
    filesets:
      - rtl_docker
      - basys3_docker
    parameters:
      - BAUDIOS=1000000
      - F_MHZ=100
    toplevel: uart
    tools:
      vivado:
        part: xc7a35tcpg236-1

  sim_docker:
    flow : sim
    flow_options:
      tool : icarus 
      iverilog_options : [-g2012]
      cocotb_module : uart_test
      timescale : 1ns/1ns
      vcs_options : [-timescale=1ns/1ns] 
    filesets : [rtl_docker, cocotb_docker]
    toplevel : uart 
    parameters :
      - BAUDIOS=1000000
      - F_MHZ=100

parameters :
  BAUDIOS :
    datatype : int
    paramtype : generic
  F_MHZ :
    datatype : int
    paramtype : generic

filesets:

  rtl:
    file_type: verilogSource
    files:
      - /home/germancq/estancia_huelva/dynamixel_SV_wishbone/uart/hdl/uart.sv
    depend:
      - ::uart_rx:1
      - uart_tx 

  cocotb:
    files:
      - /home/germancq/estancia_huelva/dynamixel_SV_wishbone/uart/tb/uart_test.py : {file_type : user, copyto : .}
    depend:
      - vlog_tb_utils

  basys3:
    file_type: xdc
    files:
      - /home/germancq/estancia_huelva/dynamixel_SV_wishbone/uart/constraints/basys3_uart.xdc

  rtl_docker:
    file_type: verilogSource
    files:
      - /work/uart/hdl/uart.sv
    depend:
      - ::uart_rx:1
      - uart_tx 

  cocotb:
    files:
      - /work/uart/tb/uart_test.py : {file_type : user, copyto : .}
    depend:
      - vlog_tb_utils

  basys3:
    file_type: xdc
    files:
      - /work/uart/constraints/basys3_uart.xdc

