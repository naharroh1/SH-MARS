  TOP_SDSPI_WB_ADDR_SIZE :
    datatype : int
    paramtype : vlogparam
  TOP_SDSPI_WB_ADDR :
    datatype : int
    paramtype : vlogparam
  TOP_WB_DATA :
    datatype : int
    paramtype : vlogparam
  MITM_UART_FIFO_DEPTH :
    datatype : int
    paramtype : vlogparam
  MITM_UART_CAPTURER_WB_ADDR_SIZE :
    datatype : int
    paramtype : vlogparam
  MITM_UART_CAPTURER_WB_ADDR :
    datatype : int
    paramtype : vlogparam
  MITM_UART_SERVO_WB_ADDR_SIZE :
    datatype : int
    paramtype : vlogparam
  MITM_UART_SERVO_WB_ADDR :
